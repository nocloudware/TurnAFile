<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Aether palette -->
    <Color x:Key="AetherAccent">#4A9EFF</Color>
    <Color x:Key="AetherGreen">#7CBA3D</Color>
    <Color x:Key="AetherGold">#F0C040</Color>
    <Color x:Key="AetherRed">#E81123</Color>
    <Color x:Key="AetherConfirm">#10893E</Color>
    <Color x:Key="AetherBg">#2A2A2A</Color>
    <Color x:Key="AetherSurface">#1E1E1E</Color>
    <Color x:Key="AetherText">#F5F5F5</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AetherAccent}"/>
    <SolidColorBrush x:Key="StatusBarBg" Color="#CC2A2A2A"/>
    <SolidColorBrush x:Key="DockBg" Color="#CC2A2A2A"/>
    <SolidColorBrush x:Key="WindowBg" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="CloseButtonBg" Color="#E81123"/>
    <SolidColorBrush x:Key="MinimizeButtonBg" Color="#555555"/>

    <!-- Aether theme: subtle glow gradient for status bar -->
    <LinearGradientBrush x:Key="StatusBarGlow" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#4A9EFF" Offset="0.0"/>
        <GradientStop Color="#7CBA3D" Offset="0.33"/>
        <GradientStop Color="#F0C040" Offset="0.66"/>
        <GradientStop Color="#4A9EFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Icon shadow effect -->
    <DropShadowEffect x:Key="IconShadow" Color="Black" Opacity="0.3"
                      BlurRadius="8" ShadowDepth="3"/>

    <!-- Floating button style (minimize / close) -->
    <Style x:Key="FloatingButton" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="0,0,4,4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
