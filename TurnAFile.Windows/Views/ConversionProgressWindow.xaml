<ui:FluentWindow x:Class="TurnAFile.Windows.Views.ConversionProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:resx="clr-namespace:TurnAFile.Windows.Resources"
        Title="{Binding Source={x:Static resx:StringsWrapper.Instance}, Path=ConversionProgress_Title}"
        Height="320" Width="600"
        MinHeight="280" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        ResizeMode="CanResize"
        ShowInTaskbar="True">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header con icono de TurnAFile -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Image Source="/Assets/Logos/icon-toggles.png" Width="24" Height="24" Margin="0,0,8,0" Stretch="Uniform"/>
            <TextBlock Text="{Binding Source={x:Static resx:StringsWrapper.Instance}, Path=ConversionProgress_Title}"
                       FontWeight="Bold"
                       FontSize="14"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}"
                Padding="16"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Origen -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Grid.Row="0">
                    <TextBlock Text="Origen:" FontWeight="SemiBold" FontSize="11" 
                               Foreground="{DynamicResource TextSecondaryBrush}" Width="50" VerticalAlignment="Center"/>
                    <Image x:Name="SourceIcon" Width="16" Height="16" Margin="0,0,4,0" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SourceFileName" Text="archivo.ext" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Flecha -->
                <TextBlock Grid.Row="1" Text="↓" FontSize="16" FontWeight="Bold" 
                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                <!-- Destino -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12" Grid.Row="2">
                    <TextBlock Text="Destino:" FontWeight="SemiBold" FontSize="11" 
                               Foreground="{DynamicResource TextSecondaryBrush}" Width="50" VerticalAlignment="Center"/>
                    <Image x:Name="TargetIcon" Width="16" Height="16" Margin="0,0,4,0" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TargetFileName" Text="archivo.ext" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <ProgressBar x:Name="ProgressBar" Grid.Row="3" Height="8" Minimum="0" Maximum="100" Value="0"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource BorderBrush}"
                             Margin="0,0,0,8"/>

                <TextBlock x:Name="PercentageText" Grid.Row="4" Text="0%" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock x:Name="StatusText" Text="Procesando archivo 1 de 5" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock x:Name="TimeRemainingText" Text="Tiempo restante: calculando..." FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <ui:Button Grid.Row="3" x:Name="CancelButton"
                Content="{Binding Source={x:Static resx:StringsWrapper.Instance}, Path=Conversion_cancelButton}"
                Click="OnCancelClick"
                HorizontalAlignment="Right"
                Padding="24,10"
                FontSize="13"
                Appearance="Secondary"/>
    </Grid>
</ui:FluentWindow>
