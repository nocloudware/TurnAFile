<ui:FluentWindow x:Class="TurnAFile.Windows.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:resx="clr-namespace:TurnAFile.Windows.Resources"
        Title="{Binding Source={x:Static resx:StringsWrapper.Instance}, Path=AboutTitle}"
        Width="550" Height="580"
        MinWidth="500" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        KeyDown="OnKeyDown">

    <Window.Icon>
        <BitmapImage UriSource="/Assets/icon-toggles.ico"/>
    </Window.Icon>

    <Grid Margin="20"
          TextElement.FontFamily="Segoe UI Variable Text, Segoe UI"
          TextOptions.TextFormattingMode="Display"
          TextOptions.TextRenderingMode="ClearType">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Logo y título -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="64" Height="64"
                    CornerRadius="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    Margin="0,0,15,0">
                <Image Source="/Assets/icon-toggles.ico"
                       Width="48" Height="48"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="TurnAFile"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="VersionText"
                               Text="Versión 1.0.0"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,0"
                               VerticalAlignment="Center"/>
                    <ui:Button x:Name="CheckUpdatesButton"
                               Click="OnCheckUpdatesClick"
                               Appearance="Transparent"
                               Padding="8,2"
                               Margin="8,0,0,0"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Content="🔍 Buscar actualizaciones"
                               ToolTip="Verificar si hay una nueva versión disponible"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Separador -->
        <Separator Grid.Row="1"
                   Background="{DynamicResource BorderBrush}"
                   Margin="0,0,0,15"/>

        <!-- Créditos (scrollable) -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,0,0,15">
            <StackPanel>

                <TextBlock Text="{Binding Source={x:Static resx:StringsWrapper.Instance}, Path=AboutCredits}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="14"
                           Margin="0,0,0,8"/>

                <TextBlock Text="{Binding Source={x:Static resx:StringsWrapper.Instance}, Path=AboutDevelopedBy}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,4"/>

                <TextBlock FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,12">
                    <Hyperlink RequestNavigate="OnHyperlinkRequestNavigate"
                               NavigateUri="https://github.com/adriangoodrich">
                        Adrian Goodrich
                    </Hyperlink>
                </TextBlock>

                <TextBlock Text="{Binding Source={x:Static resx:StringsWrapper.Instance}, Path=AboutFormatIcons}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,4"/>
                <TextBlock FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,12"
                           TextWrapping="Wrap">
                    <Hyperlink RequestNavigate="OnHyperlinkRequestNavigate"
                               NavigateUri="https://www.flaticon.com/">
                        Flaticon
                    </Hyperlink>
                    <Run Text=" - "/>
                    <Hyperlink RequestNavigate="OnHyperlinkRequestNavigate"
                               NavigateUri="https://www.iconfinder.com/">
                        Iconfinder
                    </Hyperlink>
                </TextBlock>

                <TextBlock Text="FFmpeg"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center">
                        <Hyperlink RequestNavigate="OnHyperlinkRequestNavigate"
                                   NavigateUri="https://ffmpeg.org/">
                            https://ffmpeg.org/
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text="{Binding Source={x:Static resx:StringsWrapper.Instance}, Path=AboutFFmpegDesc}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="{Binding Source={x:Static resx:StringsWrapper.Instance}, Path=AboutQuestPDF}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center">
                        <Hyperlink RequestNavigate="OnHyperlinkRequestNavigate"
                                   NavigateUri="https://www.questpdf.com/">
                            https://www.questpdf.com/
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text="{Binding Source={x:Static resx:StringsWrapper.Instance}, Path=AboutQuestPDFDesc}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="{Binding Source={x:Static resx:StringsWrapper.Instance}, Path=AboutOpenXML}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center">
                        <Hyperlink RequestNavigate="OnHyperlinkRequestNavigate"
                                   NavigateUri="https://github.com/OfficeDev/Open-XML-SDK">
                            https://github.com/OfficeDev/Open-XML-SDK
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text="{Binding Source={x:Static resx:StringsWrapper.Instance}, Path=AboutOpenXMLDesc}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="{Binding Source={x:Static resx:StringsWrapper.Instance}, Path=AboutClosedXML}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center">
                        <Hyperlink RequestNavigate="OnHyperlinkRequestNavigate"
                                   NavigateUri="https://github.com/ClosedXML/ClosedXML">
                            https://github.com/ClosedXML/ClosedXML
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text="{Binding Source={x:Static resx:StringsWrapper.Instance}, Path=AboutClosedXMLDesc}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="{Binding Source={x:Static resx:StringsWrapper.Instance}, Path=AboutSpecialThanks}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="{Binding Source={x:Static resx:StringsWrapper.Instance}, Path=AboutSpecialThanksMessage}"
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <TextBlock Text="{Binding Source={x:Static resx:StringsWrapper.Instance}, Path=AboutTechnologiesUsed}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="{Binding Source={x:Static resx:StringsWrapper.Instance}, Path=AboutTechList}"
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,12"/>

                <TextBlock Text="{Binding Source={x:Static resx:StringsWrapper.Instance}, Path=AboutLicense}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="{Binding Source={x:Static resx:StringsWrapper.Instance}, Path=AboutLicenseInfo}"
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,4"/>

                <ui:Button x:Name="ViewExternalLicensesButton"
                        Click="OnViewExternalLicensesClick"
                        Appearance="Transparent"
                        FontSize="11"
                        Padding="0,4"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource AccentBrush}"
                        Content="{Binding Source={x:Static resx:StringsWrapper.Instance}, Path=ViewExternalLicensesButton}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Botón Cerrar -->
        <ui:Button Grid.Row="3"
                Content="{Binding Source={x:Static resx:StringsWrapper.Instance}, Path=CloseButton}"
                Click="OnCloseClick"
                HorizontalAlignment="Right"
                Padding="20,8"
                FontSize="12"
                Appearance="Secondary"/>
    </Grid>
</ui:FluentWindow>