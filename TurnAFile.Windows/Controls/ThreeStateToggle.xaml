<UserControl x:Class="TurnAFile.Windows.Controls.ThreeStateToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="150" Height="28"
             Background="Transparent">
    <Grid>
        <Border x:Name="TrackBorder"
                Background="{DynamicResource BorderBrush}"
                CornerRadius="14"
                Height="28"/>

        <Canvas x:Name="ThumbCanvas"
                Height="28"
                Width="Auto">
            <Thumb x:Name="ThumbButton"
                   Width="24"
                   Height="24"
                   Canvas.Top="2"
                   Cursor="Hand"
                   DragDelta="OnThumbDragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource SurfaceBrush}"
                                CornerRadius="12"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.2"/>
                            </Border.Effect>
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Canvas>
    </Grid>
</UserControl>